# ─────────────────────────────────────────────────────────────
# Skedul — environment template
# Copy to .env.local for local dev. On Vercel, set these per environment
# (Production / Preview / Development) — see README "Environnements".
# ─────────────────────────────────────────────────────────────

# One of: development | preview | production
APP_ENV=development

# ── Database (Neon) ───────────────────────────────────────────
# Use a dedicated Neon branch per environment:
#   production  → branch "main"
#   preview     → branch "preview"
#   development → branch "development"
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── Better Auth ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (or node -e "...")
BETTER_AUTH_SECRET="change-me-32-bytes"
# The canonical URL of the deployment (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Stripe ────────────────────────────────────────────────────
# Test keys for dev/preview, live keys for production.
# Placeholder values (sk_test_xxx) enable mock-payment mode.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ── Resend ────────────────────────────────────────────────────
# Placeholder value (re_xxx) logs emails to the console instead of sending.
RESEND_API_KEY="re_..."
EMAIL_FROM="Skedul <onboarding@resend.dev>"
